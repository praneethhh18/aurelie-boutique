<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Aurelie" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rosewood</item>
        <item name="colorPrimaryDark">@color/rosewood_dark</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorOnSecondary">@color/espresso</item>

        <item name="android:colorBackground">@color/ivory</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/espresso</item>
        <item name="colorOnSurfaceVariant">@color/taupe</item>
        <item name="colorOutline">@color/hairline</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="fontFamily">sans-serif</item>
        <item name="materialButtonStyle">@style/Widget.Aurelie.Button</item>
    </style>

    <!-- ============ Type scale ============ -->
    <style name="TextAppearance.Aurelie.Wordmark" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/espresso</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0.22</item>
    </style>

    <style name="TextAppearance.Aurelie.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">@color/espresso</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Aurelie.SectionLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/taupe</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Aurelie.ProductName" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/espresso</item>
        <item name="android:letterSpacing">0.005</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="TextAppearance.Aurelie.Price" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/espresso</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.Aurelie.PriceStruck" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/taupe</item>
    </style>

    <style name="TextAppearance.Aurelie.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/espresso_muted</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <!-- ============ Components ============ -->
    <style name="Widget.Aurelie.Button" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/TextAppearance.Aurelie.ButtonLabel</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:paddingTop">17dp</item>
        <item name="android:paddingBottom">17dp</item>
        <item name="backgroundTint">@color/rosewood</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/rosewood_soft</item>
    </style>

    <style name="TextAppearance.Aurelie.ButtonLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/surface</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Widget.Aurelie.CategoryChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/category_chip_bg</item>
        <item name="chipStrokeColor">@color/category_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">22dp</item>
        <item name="android:textColor">@color/category_chip_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Aurelie.ChipLabel</item>
        <item name="chipMinHeight">42dp</item>
        <item name="chipStartPadding">18dp</item>
        <item name="chipEndPadding">18dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="android:checkable">true</item>
    </style>

    <style name="TextAppearance.Aurelie.ChipLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="Widget.Aurelie.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/rosewood_soft</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
    </style>

    <style name="Widget.Aurelie.SizeChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/size_chip_bg</item>
        <item name="chipStrokeColor">@color/category_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">14dp</item>
        <item name="android:textColor">@color/size_chip_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Aurelie.ChipLabel</item>
        <item name="chipMinHeight">50dp</item>
        <item name="chipStartPadding">20dp</item>
        <item name="chipEndPadding">20dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

</resources>
